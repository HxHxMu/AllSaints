---
import Base from "../layouts/Base.astro";
import Poster from "./Poster.astro";
import EmailBand from "./EmailBand.astro";
import { neighbors, manuscriptDate, minutes, monthName, SUPPORT_URL, disclosure, credit, type Saint, type Lang } from "../lib/episodes";
import { paths, t } from "../lib/i18n";
import { booksFor, bookUrl } from "../lib/books";

interface Props { saint: Saint; lang: Lang }
const { saint, lang } = Astro.props;
const T = t[lang], P = paths[lang];
const { prev, next } = neighbors(saint, lang);
const day = (iso: string) => lang === "es" ? `${Number(iso.slice(8, 10))} de ${monthName(iso, lang)}` : `${monthName(iso)} ${Number(iso.slice(8, 10))}`;
const feast = day(saint.date);
const books = booksFor(saint);
const alt = lang === "en" ? (saint.es ? paths.es.saint(saint.es.slug) : null) : paths.en.saint(saint.slug);
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Article",
  inLanguage: lang,
  headline: saint.name,
  description: saint.summary || saint.hook,
  datePublished: saint.date,
  image: saint.cover ? [saint.cover] : undefined,
  url,
  author: { "@type": "Organization", name: "All Saints", url: "https://allholysaints.com/" },
  publisher: { "@type": "Organization", name: "All Saints" },
  about: { "@type": "Person", name: saint.name, description: [saint.dates, saint.region].filter(Boolean).join(", ") },
  ...(saint.youtubeId && {
    video: {
      "@type": "VideoObject", name: `${saint.name} in one minute`, description: saint.hook,
      thumbnailUrl: saint.cover ? [saint.cover] : undefined, uploadDate: saint.date,
      embedUrl: `https://www.youtube-nocookie.com/embed/${saint.youtubeId}`,
      contentUrl: `https://www.youtube.com/shorts/${saint.youtubeId}`,
    },
  }),
};
---
<Base title={saint.name} description={saint.summary || saint.hook} image={saint.cover} type="article" jsonld={jsonld} lang={lang} alt={alt}>
  <article class="saint">
    <div class="art"><Poster saint={saint} eager height="page" lang={lang} /></div>
    <div class="text wrap">
      <header class="head rise">
        <p class="numeral date"><time datetime={saint.date}>{manuscriptDate(saint.date, lang)}</time></p>
        <h1 class="name">{saint.name}</h1>
        <p class="meta muted">
          {saint.dates && <span class="numeral plain">{saint.dates}</span>}
          {saint.region && <span> · {saint.region}</span>}
          {saint.martyr && <span> · {T.martyr}</span>}
        </p>
        {saint.patronages.length > 0 && <p class="meta muted">{T.patron} {saint.patronages.join(", ")}</p>}
        <p class="devotional hook">{saint.hook}</p>
        {saint.youtubeId && (
          <button class="rubric" type="button" data-play={saint.youtubeId}><span>{T.watch}</span><span class="numeral">{minutes(saint.duration)}</span></button>
        )}
      </header>

      <div class="story">
        {saint.story.map((p) => <p set:text={p} />)}
      </div>

      <p class="prayer devotional">{saint.prayer}</p>

      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h" class="label">{T.sources}</h2>
        <ul>
          {saint.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}</li>)}
        </ul>
        <p class="muted small">{T.art}: {saint.credits.map((c) => credit(c, lang)).join("; ") || T.publicDomain}. {disclosure(lang)}</p>
      </section>

      {books.length > 0 && (
        <section class="books" aria-labelledby="books-h">
          <h2 id="books-h" class="label">{T.deeper}</h2>
          <ul>
            {books.map((b) => <li><a href={bookUrl(b)} rel="noopener sponsored"><cite>{b.title}</cite></a><span class="muted">{b.author}</span></li>)}
          </ul>
          <p class="muted small">{T.booksFine}</p>
        </section>
      )}

      {SUPPORT_URL && (
        <section class="support" aria-label="All Saints">
          <a class="rubric" href={SUPPORT_URL} rel="noopener">
            <span>{T.candle}<small>{T.candleSub}</small></span><span aria-hidden="true">›</span>
          </a>
        </section>
      )}

      <nav class="days" aria-label={T.otherDays}>
        {prev ? <a href={P.saint(prev.slug)}><span class="label">‹ {day(prev.date)}</span><b>{prev.display}</b></a> : <span />}
        {next ? <a class="r" href={P.saint(next.slug)}><span class="label">{day(next.date)} ›</span><b>{next.display}</b></a>
              : <a class="r" href={P.calendar}><span class="label">{T.allSaints}</span><b>{T.theCalendar}</b></a>}
      </nav>
      <p class="feast muted">{T.feast}: {feast}</p>
    </div>
  </article>
  <EmailBand lang={lang} />
</Base>

<style>
  .text { display: grid; gap: 0; padding-top: 22px; }
  .head { display: grid; gap: 10px; }
  .date { font-size: 1.1875rem; }
  .meta { font-size: 1.0625rem; }
  .plain { color: inherit; }
  .hook { font-size: 1.4375rem; line-height: 1.3; margin: 6px 0 14px; }
  .story { margin-top: 36px; max-width: var(--measure); }
  .story p + p { margin-top: 1em; }
  .story p:first-child::first-letter {
    font-family: var(--display); color: var(--gilt); float: left; font-size: 3.6rem; line-height: .9; padding: 6px 8px 0 0;
  }
  .prayer { font-size: 1.875rem; line-height: 1.2; color: var(--gilt-light); margin: 40px 0 8px; }
  .sources { margin-top: 48px; display: grid; gap: 8px; max-width: var(--measure); }
  .sources h2 { font-weight: 400; }
  .sources ul { margin: 0; padding-left: 1.1em; font-size: 1.0625rem; }
  .small { font-size: 1rem; line-height: 1.5; }
  .books { margin-top: 40px; display: grid; gap: 10px; max-width: var(--measure); }
  .books h2 { font-weight: 400; }
  .books ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .books li { display: grid; gap: 2px; font-size: 1.125rem; line-height: 1.35; }
  .books cite { font-style: italic; }
  .books li .muted { font-size: 1rem; }
  .support { margin-top: 40px; max-width: 30rem; }
  .days { display: flex; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--rule); }
  .days a { text-decoration: none; color: var(--vellum); display: grid; }
  .days a:hover b { color: var(--gilt-light); }
  .days b { font-weight: 400; font-size: 1.125rem; }
  .days .r { text-align: right; }
  .feast { margin-top: 18px; font-size: 1rem; }
  @media (min-width: 1024px) {
    .saint { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; max-width: 1200px; margin-inline: auto; padding-inline: var(--gutter); align-items: start; }
    .art { position: sticky; top: 24px; }
    .text { padding-inline: 0; padding-top: 0; }
  }
</style>
