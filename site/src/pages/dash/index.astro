---
// Private dashboard: a shell that fills itself from /api/dash-data (functions/api/dash-data.ts), behind
// Cloudflare Access. Nothing private is in this file or the build. Kept out of the sitemap and search.
// Numbers come from engine/metrics.py (nightly) plus Beehiiv and Ko-fi, read live.
import "@fontsource/cinzel/600.css";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../../styles/global.css";
import "../../styles/dash.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard · All Saints</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <main class="wrap dash" id="main">
    <header class="top">
      <a href="/" class="mono" aria-label="All Saints home">A.S.†</a>
      <p class="label" id="updated">Loading…</p>
    </header>
    <h1 class="name">The Ledger</h1>
    <p class="sample" id="sample" hidden>Local test file, not live numbers.</p>
    <ul class="notes" id="notes" hidden></ul>
    <p class="muted" id="error" hidden></p>

    <section aria-labelledby="h-pipe">
      <h2 class="sec" id="h-pipe">The coming days</h2>
      <ol class="litany" id="upcoming"></ol>
      <div class="problems" id="problems" hidden></div>
      <div class="tiles" id="cost"></div>
    </section>

    <section aria-labelledby="h-aud">
      <h2 class="sec" id="h-aud">Who is listening</h2>
      <div class="tiles" id="audience"></div>
      <figure class="chart" id="yt-daily-fig" hidden>
        <figcaption class="label">YouTube views per day, last 28 days</figcaption>
        <div id="yt-daily"></div>
      </figure>
      <figure class="chart" id="scatter-fig" hidden>
        <figcaption class="label">Average % viewed against the length of the WHO line</figcaption>
        <div id="scatter"></div>
        <p class="muted small">Each dot is one Short. The Nov 15 question: do shorter WHO lines keep more viewers?</p>
      </figure>
      <div class="table-wrap">
        <table id="episodes">
          <caption class="label">Every published saint, newest first</caption>
          <thead><tr>
            <th scope="col">Feast</th><th scope="col">Saint</th>
            <th scope="col" class="n">YT views</th><th scope="col" class="n">Avg viewed</th><th scope="col" class="n">YT shares</th><th scope="col" class="n">Subs</th>
            <th scope="col" class="n">IG views</th><th scope="col" class="n">FB plays</th><th scope="col" class="n">TikTok views</th><th scope="col" class="n">Threads views</th><th scope="col" class="n">IG shares</th><th scope="col" class="n">Saved</th>
            <th scope="col" class="n">Length</th><th scope="col" class="n">WHO words</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="cols" id="countries"></div>
    </section>

    <section aria-labelledby="h-search">
      <h2 class="sec" id="h-search">Found by search</h2>
      <div class="tiles" id="search-tiles"></div>
      <figure class="chart" id="gsc-fig" hidden>
        <figcaption class="label">Google clicks per day</figcaption>
        <div id="gsc-clicks"></div>
      </figure>
      <figure class="chart" id="gsc-imp-fig" hidden>
        <figcaption class="label">Google impressions per day</figcaption>
        <div id="gsc-imp"></div>
      </figure>
      <div class="cols" id="search-lists"></div>
    </section>

    <section aria-labelledby="h-support">
      <h2 class="sec" id="h-support">Candles lit</h2>
      <div class="tiles" id="support"></div>
      <ol class="litany" id="candles"></ol>
    </section>
  </main>
  <div class="tip" id="tip" role="status" hidden></div>

  <script>
    import "../../scripts/dash.ts";
  </script>
</body>
</html>
