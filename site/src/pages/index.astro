---
import Base from "../layouts/Base.astro";
import Poster from "../components/Poster.astro";
import { latest, neighbors, manuscriptDate, minutes, TAGLINE } from "../lib/episodes";

const today = latest();
const { prev } = today ? neighbors(today) : { prev: undefined };
---
<Base title="All Saints" description={`One forgotten saint a day, on their feast day. ${TAGLINE}`} image={today?.cover}>
  {today ? (
    <article class="today">
      <div class="art"><Poster saint={today} eager /></div>
      <div class="info wrap rise">
        <p class="numeral date"><time datetime={today.date}>{manuscriptDate(today.date)}</time></p>
        <h1 class="name"><a href={`/saints/${today.slug}/`}>{today.name}</a></h1>
        <p class="devotional hook">{today.hook}</p>
        {today.youtubeId
          ? <button class="rubric" type="button" data-play={today.youtubeId}><span>▶ Watch the story</span><span class="numeral">{minutes(today.duration)}</span></button>
          : <a class="rubric" href={`/saints/${today.slug}/`}><span>Read the story</span><span aria-hidden="true">›</span></a>}
        {today.youtubeId && <p class="more"><a href={`/saints/${today.slug}/`}>Read the full story and prayer</a></p>}
      </div>
      <nav class="days wrap" aria-label="Other days">
        {prev && <a href={`/saints/${prev.slug}/`}><span class="label">‹ Yesterday</span><b>{prev.display}</b></a>}
        <a class="cal" href="/calendar/"><span class="label">All saints ›</span><b>The calendar</b></a>
      </nav>
    </article>
  ) : (
    <section class="wrap empty"><h1 class="name">All Saints</h1><p class="devotional">{TAGLINE}</p><p>The first saint arrives soon.</p></section>
  )}
</Base>

<style>
  .info { padding-top: 22px; display: grid; gap: 10px; }
  .date { font-size: 1.1875rem; letter-spacing: .04em; }
  .name a { color: inherit; text-decoration: none; }
  .hook { font-size: 1.4375rem; line-height: 1.3; margin-bottom: 12px; }
  .more { font-size: 1.0625rem; }
  .days { display: flex; justify-content: space-between; gap: 16px; margin-top: 28px; padding-block: 22px; border-top: 1px solid var(--rule); }
  .days a { text-decoration: none; color: var(--vellum); display: grid; }
  .days a:hover b { color: var(--gilt-light); }
  .days b { font-weight: 400; font-size: 1.125rem; }
  .days .cal { text-align: right; margin-left: auto; }
  .empty { padding-block: 120px; display: grid; gap: 16px; }
  @media (min-width: 1024px) {
    .today { display: grid; grid-template-columns: 2fr 3fr; grid-template-areas: "info art" "days art"; max-width: 1200px; margin-inline: auto; padding-inline: var(--gutter); gap: 0 48px; align-items: end; }
    .art { grid-area: art; }
    .info { grid-area: info; padding-inline: 0; max-width: 34rem; }
    .days { grid-area: days; padding-inline: 0; }
  }
</style>
