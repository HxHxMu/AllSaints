---
import "@fontsource/cinzel/600.css";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../styles/global.css";
import { saintsIn, type Lang } from "../lib/episodes";
import { paths, t } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  image?: string | null;
  type?: "website" | "article";
  jsonld?: object;
  current?: "calendar";
  lang?: Lang;
  /** the same page in the other language, when it exists (hreflang + the EN/ES switch) */
  alt?: string | null;
}
const { title, description, image, type = "website", jsonld, current, lang = "en", alt } = Astro.props;
const T = t[lang], P = paths[lang];
const other: Lang = lang === "en" ? "es" : "en";
const hasEs = lang === "es" || saintsIn("es").length > 0;  // no ES switch until the first translation exists
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "All Saints" ? `All Saints · ${T.tagline}` : `${title} · All Saints`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {alt && <link rel="alternate" hreflang={lang} href={canonical}>}
  {alt && <link rel="alternate" hreflang={other} href={new URL(alt, Astro.site)}>}
  <meta name="theme-color" content="#0D0B09">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:site_name" content="All Saints">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {image && <meta property="og:image" content={image}>}
  <meta name="twitter:card" content={image ? "summary_large_image" : "summary"}>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="visually-hidden" href="#main">{T.skip}</a>
  <header class="bar wrap">
    <a class="mono" href={P.home} aria-label={T.homeLabel}>A.S.†</a>
    <nav class="label" aria-label="Main">
      <a href={P.calendar} aria-current={current === "calendar" ? "page" : undefined}>{T.calendar}</a>
      {hasEs && <span aria-hidden="true"> · </span>}
      {hasEs && <span class="lang">
        {lang === "en" ? <b>EN</b> : <a href={alt || paths.en.home} hreflang="en" lang="en">EN</a>}
        <span aria-hidden="true"> / </span>
        {lang === "es" ? <b>ES</b> : <a href={alt || paths.es.home} hreflang="es" lang="es">ES</a>}
      </span>}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot wrap">
    <p class="devotional tag">{T.tagline}</p>
    <p class="label links">
      <a href="/about/">{T.about}</a> · <a href="https://www.instagram.com/all.holy.saints/">Instagram</a> ·
      <a href="https://www.youtube.com/@AllHolySaints">YouTube</a> · <a href="/privacy/">{T.privacy}</a> · <a href="/terms/">{T.terms}</a>
    </p>
    <p class="label">hello@allholysaints.com</p>
  </footer>
</body>
</html>

<style>
  .bar { display: flex; justify-content: space-between; align-items: baseline; padding-block: 16px 12px; }
  .mono { font-family: var(--display); font-weight: 600; letter-spacing: .14em; color: var(--gilt); text-decoration: none; font-size: 1.0625rem; }
  nav a { color: var(--ash); text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { color: var(--vellum); }
  .lang b { color: var(--vellum); font-weight: 500; }
  .foot { padding-block: 72px 48px; display: grid; gap: 10px; }
  .tag { font-size: 1.4375rem; color: var(--vellum); }
  .links a { color: var(--ash); }
  .links a:hover { color: var(--vellum); }
</style>
